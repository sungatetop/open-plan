{
  "name": "open-plan",
  "version": "0.11.55",
  "private": true,
  "description": "Open Plan（规聚）— 面向规划工程师的 AI 一体化工作台：Office 文档、知识库、地图可视化与 Agent 协作",
  "keywords": [
    "ai-agent",
    "planning",
    "office",
    "knowledge-base",
    "map",
    "pi-agent-sdk",
    "react"
  ],
  "homepage": "https://github.com/oscarkincanland/open-plan#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oscarkincanland/open-plan.git"
  },
  "bugs": {
    "url": "https://github.com/oscarkincanland/open-plan/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "verify": "npm run desktop:typecheck && npm run desktop:test && npm run desktop:smoke",
    "setup": "node scripts/tools/install-officecli.mjs",
    "map:cleanup-layers": "node scripts/tools/cleanup-map-layers.mjs",
    "map:fetch": "node scripts/tools/fetch-boundaries.mjs",
    "map:prepare": "node scripts/tools/prepare-map-data.mjs",
    "map:tiles": "node scripts/tools/build-vector-tiles.mjs",
    "map:data": "npm run map:fetch && npm run map:prepare && npm run map:tiles",
    "map:m2-data": "node scripts/tools/generate-m2-data.mjs",
    "map:glyphs": "node scripts/tools/generate-map-glyphs.mjs",
    "desktop:dev": "npm --prefix electron run dev",
    "desktop:build": "npm --prefix electron run build",
    "desktop:typecheck": "npm --prefix electron run typecheck",
    "desktop:test": "npm --prefix electron test",
    "desktop:smoke": "npm --prefix electron run smoke",
    "desktop:dist": "npm --prefix electron run dist",
    "test:map-layers:live": "node scripts/map-layer-entry-scene-test.mjs",
    "test:map-visual:live": "node scripts/map-visual-panel-scene-test.mjs",
    "test:map-chat:live": "node scripts/map-chat-scene-test.mjs",
    "test:map-perf": "node scripts/map-perf-baseline.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@modelcontextprotocol/client": "^2.1.0",
    "docx": "^9.7.1",
    "geojson-vt": "^5.0.2",
    "jszip": "^3.10.2",
    "pptxgenjs": "^4.0.1",
    "typebox": "^1.3.30",
    "undici": "8.10.2",
    "vt-pbf": "^3.1.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "pbf": "^5.1.2",
    "vt-pbf": "^3.1.3"
  }
}
